# Zaprite API key for the org that receives the demo payments (server-only).
ZAPRITE_API_KEY=

# Optional: the Zaprite checkout to use (with Zaprite Pay enabled). Leave empty to use the org's default checkout.
ZAPRITE_CHECKOUT_ID=

# Optional: point at another Zaprite environment or a local mock. Defaults to https://api.zaprite.com/v1.
# ZAPRITE_API_BASE=
